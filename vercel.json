{
  "regions": ["sin1"],
  "functions": {
    "api/**/*.py": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron?type=reminder&mode=santai",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron?type=reminder&mode=keras",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron?type=auto",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/cron?type=reminder&mode=keras&force=1",
      "schedule": "5 15 * * *"
    }
  ]
}
